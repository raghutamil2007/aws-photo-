PORT=3000

# Optional: Render sets its own public URL automatically, but you can override:
# BASE_URL=https://event-photos.onrender.com

# ─── Firebase Configuration (Free Tier: 5GB Storage + Firestore DB) ─────────
# In Render, paste the contents of your downloaded Firebase serviceAccountKey.json:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Optional: storage bucket name if not default <project_id>.appspot.com:
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
