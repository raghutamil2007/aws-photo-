# Port for local development
PORT=3000

# Optional explicit public URL (Render sets its own automatically)
# BASE_URL=https://event-photos.onrender.com

# ─── Cloudinary (Free 25 GB Photo Storage) ──────────────────────────
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Alternatively, you can use the single CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── MongoDB Atlas (Free 512 MB Cloud Database) ─────────────────────
# Create free M0 cluster at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=event_photos
